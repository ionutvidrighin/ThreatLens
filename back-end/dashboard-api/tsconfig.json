{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"paths": { "@/*": ["./src/*"] },
		"types": ["node", "aws-lambda"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
