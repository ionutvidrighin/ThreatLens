# Copy this file to .env.local and replace every <placeholder> with the value
# from your own AWS deployment. .env.local is git-ignored; never commit it.

# <region>: the AWS region the stack is deployed in (e.g. eu-west-1)

# Base URL of the dashboard API (API Gateway).
# <api-id> is the ID of your HTTP API: API Gateway console > your API > "API ID".
VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# Cognito user pool the dashboard signs in against.
# <user-pool-id> looks like <region>_AbCdEfGhI: Cognito console > User pools > "User pool ID".
VITE_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>

# <app-client-id>: Cognito console > your user pool > App integration > App clients.
# Use the client created for this single-page app (one without a client secret).
VITE_COGNITO_CLIENT_ID=<app-client-id>

# Hosted UI domain: Cognito console > your user pool > App integration > Domain.
# <domain-prefix> is the prefix you chose when creating the domain.
VITE_COGNITO_DOMAIN=https://<domain-prefix>.auth.<region>.amazoncognito.com

# Where the dashboard is served from; must match an allowed callback URL on the
# Cognito app client. Vite's dev server default is shown.
VITE_APP_URL=http://localhost:5173

# OAuth scopes requested at sign-in; must be enabled on the Cognito app client.
# threatlens-api is the resource server identifier defined in the user pool.
VITE_OAUTH_SCOPE=openid email threatlens-api/rules.read threatlens-api/rules.write
